# Shared environment variables for all services

# ============================================================
# RabbitMQ Connection
# ============================================================
RABBITMQ_URL=amqps://burraqtq:yFx0LDD76FrrDRFLhd2Wk_R68YfwhG00@cow.rmq2.cloudamqp.com/burraqtq

# ============================================================
# motor_dynamic → forecasting-service
# ============================================================
MOTOR_EXCHANGE=motor_exchange
MOTOR_QUEUE=motor.raw
MOTOR_ROUTING_KEY=motor.raw
MOTOR_DLX_QUEUE=motor.raw.dlx

# ============================================================
# forecasting-service → downstream
# ============================================================
FORECASTING_EXCHANGE=forecasting_exchange

EQUIPMENT_STATUS_QUEUE=equipment.status
EQUIPMENT_STATUS_ROUTING_KEY=equipment.status

ALERTS_QUEUE=equipment.alerts
ALERTS_ROUTING_KEY=equipment.alerts

# Database (shared for results storage)
DATABASE_URL=sqlite:///./shared.db

# Other shared settings
LOG_LEVEL=INFO
MAX_RETRIES=3
STRICT_VALIDATION=false

# Motor Dynamic (ingest)
DATA_DIR=src/raw
EXTENSIONS=.csv,.txt
HAS_HEADER=true
CSV_DELIMITER=,
WINDOW_SIZE=50
WINDOW_STEP=64


# ──────────────────────────────────────────────
# Consulting Service — All settings live here
# ──────────────────────────────────────────────

# ChromaDB
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=maintenance_manuals

# Knowledge base
KNOWLEDGE_FOLDER=./knowledge

# Embedding model (local, no API key needed)
EMBED_MODEL=all-MiniLM-L6-v2
EMBED_BATCH_SIZE=64

# LLM — fast CPU models (ollama pull <model> first):
#   qwen2.5:1.5b  ← recommended (~1GB)
#   phi3:mini     ← Microsoft  (~2GB)
#   gemma2:2b     ← Google     (~1.5GB)
#   tinyllama     ← ultra-fast (~600MB)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
LLAMA_TIMEOUT=120

# LLM generation tuning
LLM_TEMPERATURE=0.1
LLM_NUM_PREDICT=1024
LLM_NUM_CTX=4096
LLM_REPEAT_PENALTY=1.1

# RAG
RAG_TOP_K=5

# API server
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

SEARCH_FALLBACK=true
TAVILY_API_KEY=your api key