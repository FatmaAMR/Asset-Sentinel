# Database (shared for results storage)
DATABASE_URL=sqlite:///./shared.db

# Other shared settings
LOG_LEVEL=INFO
MAX_RETRIES=3
STRICT_VALIDATION=false

# Motor Dynamic (ingest)
DATA_DIR=src/raw
EXTENSIONS=.csv,.txt
HAS_HEADER=true
CSV_DELIMITER=,
WINDOW_SIZE=50
WINDOW_STEP=64

# ============================================================
# motor_dynamic → forecasting-service
# ============================================================
MOTOR_EXCHANGE=motor_exchange
MOTOR_QUEUE=motor.raw
MOTOR_ROUTING_KEY=motor.raw
MOTOR_DLX_QUEUE=motor.raw.dlx
