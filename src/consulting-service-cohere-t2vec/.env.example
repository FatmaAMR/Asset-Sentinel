# ──────────────────────────────────────────────
# Consulting Service — All settings live here
# ──────────────────────────────────────────────

# ChromaDB
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=maintenance_manuals

# Knowledge base
KNOWLEDGE_FOLDER=./knowledge

# ── Cohere Embedding ──────────────────────────
# Get your free key at https://dashboard.cohere.com
COHERE_API_KEY=

# Model options:
#   embed-english-v3.0      — English-only documents (best accuracy)
#   embed-multilingual-v3.0 — mixed-language documents
EMBED_MODEL=embed-english-v3.0

# Max items per Cohere batch call (API hard cap = 96; keep ≤ 64 to be safe)
EMBED_BATCH_SIZE=64

# ── LLM ──────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
LLAMA_TIMEOUT=120

# LLM generation tuning
LLM_TEMPERATURE=0.1
LLM_NUM_PREDICT=1024
LLM_NUM_CTX=4096
LLM_REPEAT_PENALTY=1.1

# ── RAG ───────────────────────────────────────
RAG_TOP_K=5

# ── API server ────────────────────────────────
HOST=0.0.0.0
PORT=8002
LOG_LEVEL=INFO

# ── Web search fallback ───────────────────────
SEARCH_FALLBACK=true
TAVILY_API_KEY=your-tavily-api-key-here

# ── RabbitMQ ──────────────────────────────────
# Format: amqp://<user>:<password>@<host>:<port>/<vhost>
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
