# Copy this file to .env and set DATA_DIR — that is the only required change.
DATA_DIR=C:\Users\user\Downloads\grad project

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=motor_data
RABBITMQ_ROUTING_KEY=raw
RABBITMQ_QUEUE=motor.raw
RABBITMQ_DLX_QUEUE=motor.failed

WINDOW_SIZE=1024
WINDOW_STEP=1024
MAX_RETRIES=3

FILE_EXTENSIONS=csv,txt
CSV_DELIMITER=
HAS_HEADER=true
